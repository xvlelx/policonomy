# Policonomy 환경변수 예시
# 이 파일을 복사하여 .env 로 저장 후 값을 채우세요.

# Groq API (기본 추천 - 빠르고 무료)
# https://console.groq.com 에서 발급
GROQ_API_KEY=gsk_...

# Anthropic Claude API (use_local=False, use_groq=False 일 때)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama 로컬 모델 (use_groq=False, use_local=True 일 때)
# OLLAMA_URL=http://localhost:11434/v1
# LOCAL_MODEL=gemma4:e4b

# 관리자 API 키 (/api/subscribers 엔드포인트 보호용)
POLICONOMY_ADMIN_KEY=your-secret-admin-key-here

# AWS SES 이메일 발송 (선택)
# https://console.aws.amazon.com/ses 에서 도메인/이메일 인증 후 사용
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-northeast-2
SES_FROM_EMAIL=newsletter@yourdomain.com
ALERT_EMAIL=your@email.com          # 파이프라인 실패 알림 받을 이메일 (미설정 시 SES_FROM_EMAIL 사용)
