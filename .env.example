# Policonomy 환경변수 예시
# 이 파일을 복사하여 .env 로 저장 후 값을 채우세요.

# Groq API (필수) — https://console.groq.com 에서 발급
GROQ_API_KEY=gsk_...

# 관리자 API 키 — 파이프라인 실행, 구독자 조회, 설정 저장, 리포트 즉시 생성
POLICONOMY_ADMIN_KEY=your-secret-admin-key-here

# 수신거부 링크 서명 키 (미설정 시 POLICONOMY_ADMIN_KEY 사용)
# 바꾸면 이미 발송된 메일의 수신거부 링크가 무효가 됨
UNSUBSCRIBE_SECRET=

# 프론트엔드 주소 — 이메일의 구독 확인 / 수신거부 링크에 사용
SITE_URL=http://localhost:3000

# 백엔드 CORS 허용 origin (쉼표 구분)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS SES 이메일 발송
# https://console.aws.amazon.com/ses 에서 도메인/이메일 인증 후 사용
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=ap-northeast-2
SES_FROM_EMAIL=newsletter@yourdomain.com
# 파이프라인 실패 알림 받을 이메일 (미설정 시 SES_FROM_EMAIL 사용)
ALERT_EMAIL=your@email.com
